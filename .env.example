# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Panel bot with buttons: create one in @BotFather (/newbot) and paste its token.
BOT_TOKEN=

# Where the login session and rules live (mounted as a volume in docker).
DATA_DIR=data

# Don't send the same auto-reply to the same chat more often than this.
REPLY_COOLDOWN_SECONDS=600

# AI chats: an API key from https://platform.claude.com (Max plans come with
# monthly API credits). Leave empty to keep AI chats off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low
# Spend caps: AI replies per chat and in total per day.
AI_DAILY_PER_CHAT=20
AI_DAILY_TOTAL=200
# Private chats with people you know skip both daily caps; false puts them back.
AI_KNOWN_UNLIMITED=true
# A stranger who wrote first gets at most this many AI replies, then a report.
AI_STRANGER_LIMIT=10
# Sent in an AI chat in reply to a voice message or a video (the AI only reads
# text). Empty = say nothing.
AI_MEDIA_REPLY=голосовые и видео сейчас не могу послушать, напиши текстом
# DeepSeek for chats you switch to it with ".model deepseek" (e.g. banter with
# a friend): a key from https://platform.deepseek.com. Empty = Claude everywhere.
DEEPSEEK_API_KEY=
# Not deepseek-chat: that's an old alias for flash with thinking off.
DEEPSEEK_MODEL=deepseek-flash
# How much it thinks before answering: low | high | max (empty = model default).
DEEPSEEK_EFFORT=low
# DeepSeek's prices in $ per 1M tokens, for .usage: input, input from its cache,
# output (see https://api-docs.deepseek.com/quick_start/pricing). 0 = not counted.
DEEPSEEK_PRICE_INPUT=0
DEEPSEEK_PRICE_CACHE_HIT=0
DEEPSEEK_PRICE_OUTPUT=0

# Pinged every 5 minutes while the bot is alive (e.g. a check on
# https://healthchecks.io): it tells you when the pings stop. Empty = off.
HEALTHCHECK_URL=
# The panel gets rules.json and a copy of the database this often; 0 = never.
BACKUP_DAYS=7

# The Mini App: its public address (expense-tracker's nginx proxies /tg/ here).
# Empty = no Mini App and no port.
WEBAPP_URL=
