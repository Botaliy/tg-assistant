# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Panel bot with buttons: create one in @BotFather (/newbot) and paste its token.
BOT_TOKEN=

# Where the login session and rules live (mounted as a volume in docker).
DATA_DIR=data

# Don't send the same auto-reply to the same chat more often than this.
REPLY_COOLDOWN_SECONDS=600

# AI chats: an API key from https://platform.claude.com (Max plans come with
# monthly API credits). Leave empty to keep AI chats off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low
# Spend caps: AI replies per chat and in total per day.
AI_DAILY_PER_CHAT=20
AI_DAILY_TOTAL=200
# A stranger who wrote first gets at most this many AI replies, then a report.
AI_STRANGER_LIMIT=10
